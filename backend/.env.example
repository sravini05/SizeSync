# Copy this file to .env and adjust as needed.

SIZESYNC_STORAGE_DIR=./storage
SIZESYNC_DATABASE_URL=sqlite:///./sizesync.db
SIZESYNC_MAX_UPLOAD_MB=15
SIZESYNC_POSE_MODEL_PATH=./models/pose_landmarker_full.task
SIZESYNC_CORS_ORIGINS=http://localhost:5173

# Set to "smplx-multiview" once you've downloaded the SMPL-X + VPoser model
# files (see README.md "Stage 2 setup"). Leave as "prototype" until then --
# it will not fabricate results, it will just tell you it's not implemented.
SIZESYNC_RECONSTRUCTION_BACKEND=prototype

# -- Stage 2 --
SIZESYNC_SMPLX_MODEL_DIR=./models/smplx
SIZESYNC_SMPLX_GENDER=neutral
SIZESYNC_VPOSER_DIR=./models/vposer_v2_05
# "auto" picks cuda if available, else cpu. Never fails silently -- if you
# force "cuda" without a GPU/CUDA-build of torch, it errors clearly instead.
SIZESYNC_RECONSTRUCTION_DEVICE=auto
SIZESYNC_FIT_ITERS_STAGE1=60
SIZESYNC_FIT_ITERS_STAGE2=120
SIZESYNC_FIT_ITERS_STAGE3=120
